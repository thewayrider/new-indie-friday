{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:slug",
      "destination": "https://archive.streamusique.com/:year/:month/:slug",
      "permanent": true
    },
    {
      "source": "/p/:slug",
      "destination": "https://archive.streamusique.com/p/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "Accept",
          "value": "(.*text/markdown.*)"
        }
      ],
      "destination": "/llms.txt"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    }
  ]
}
